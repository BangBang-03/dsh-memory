{
  "name": "dsh-memory",
  "version": "0.3.1",
  "private": true,
  "description": "DSH 工作区长期记忆：索引式简报省 token、轮末相关召回、memory 工具按需读写、版本链与体检、轮次结束自动提炼（可草稿审批），设置面板里可视化查看与管理。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "workspace",
    "workbuddy",
    "qoder"
  ],
  "license": "MIT",
  "author": "BangBang-03",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/BangBang-03/dsh-memory.git"
  },
  "homepage": "https://github.com/BangBang-03/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/BangBang-03/dsh-memory/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "test",
    "icon.svg",
    "cordis.patch.yml",
    "install.ps1",
    "uninstall.ps1",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  }
}
