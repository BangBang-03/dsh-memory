{
  "name": "@bangbang-03/dsh-memory",
  "version": "0.6.7",
  "description": "DSH 工作区记忆画像：有证据、有版本、能解释变化；索引简报省 token、轮末本地召回、红线 / 审批队列 / 版本链 / 注入审计；零依赖、不出站。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "workspace",
    "workbuddy",
    "qoder",
    "workspace-memory",
    "memory-bank",
    "memory-tool",
    "approval-queue",
    "portrait",
    "memory-portrait",
    "agent-memory",
    "ai-agents",
    "coding-agent",
    "prompt-caching",
    "local-first",
    "governance"
  ],
  "license": "MIT",
  "author": "BangBang-03",
  "icon": "icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BangBang-03/dsh-memory-portrait.git"
  },
  "homepage": "https://bangbang-03.github.io/dsh-memory-portrait/",
  "bugs": {
    "url": "https://github.com/BangBang-03/dsh-memory-portrait/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "install.ps1",
    "uninstall.ps1",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "marketplace": {
      "profiles": [
        "web",
        "desktop"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": true
    },
    "permissions": {
      "level": "medium",
      "files": "read-write",
      "network": "none",
      "commands": "git",
      "credentials": [],
      "externalServices": [],
      "notes": "Read/write under ~/.dsh/storages/dsh-memory; optional workspace mirror <ws>/.dsh-memory/MEMORY.md and the AGENTS.md managed block. Read-only scans of WorkBuddy / Qoder / Claude Code / Codex / Windsurf memory dirs happen only on import. No outbound network; the settings API is served on the host's loopback webServer. The local git binary is used only for workspace identity detection."
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "unknown",
        "0.2.1-rc.5": "compatible",
        "0.2.2-alpha.2": "unknown"
      }
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "prepublishOnly": "node test/run-all.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
